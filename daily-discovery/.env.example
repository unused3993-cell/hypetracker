# Anthropic API key (https://console.anthropic.com/settings/keys).
# Web search and web fetch must be enabled for your organization in the Console.
ANTHROPIC_API_KEY=

# Optional: override the model used for every pipeline step.
# CLAUDE_MODEL=claude-opus-5-5

# Supabase project settings -> API.
SUPABASE_URL=
# Server-side only. Either the legacy "service_role" key or a new "secret" key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=
