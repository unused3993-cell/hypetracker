# Anthropic API key (https://console.anthropic.com/settings/keys).
# Web search must be enabled for your organization in the Console (used only as a fallback).
ANTHROPIC_API_KEY=

# Supabase project settings -> API.
SUPABASE_URL=
# Server-side only. Either the legacy "service_role" key or a new "secret" key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# Budget per generation (USD). The cap is enforced before every model call.
# BUDGET_TARGET_USD=0.25
# BUDGET_MAX_USD=0.35

# Models per stage (defaults shown). Compare writers with `npm run compare-writers`.
# MODEL_TOPICS=claude-sonnet-5-5
# MODEL_SEARCH=claude-haiku-5-5
# MODEL_EXTRACT=claude-haiku-5-5
# MODEL_WRITE=claude-opus-5-5
# MODEL_VERIFY=claude-sonnet-5-5
# Effort and output caps per stage: EFFORT_WRITE=medium, MAX_TOKENS_WRITE=5000, etc. (see lib/config.ts)

# Web search fallback. web_search_20260209 is documented for Opus/Sonnet; Haiku uses the basic tool.
# SEARCH_TOOL=web_search_20250305
# MAX_WEB_SEARCHES=3

# Identify the crawler to site owners (a URL or address you control).
# CRAWLER_CONTACT=https://example.com/about-our-crawler
# OpenAlex asks for a contact address to use its faster "polite pool" (optional).
# OPENALEX_MAILTO=
